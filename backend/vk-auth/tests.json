{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Exchange code - missing params",
      "method": "POST",
      "path": "/",
      "body": {"action": "exchange_code"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with token - missing token",
      "method": "POST",
      "path": "/",
      "body": {"action": "login_with_token"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Me without token",
      "method": "POST",
      "path": "/",
      "body": {"action": "me"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Leaderboard solo",
      "method": "POST",
      "path": "/",
      "body": {"action": "leaderboard", "rating_type": "solo"},
      "expectedStatus": 200,
      "expectedBody": {"rating_type": "solo"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Leaderboard online",
      "method": "POST",
      "path": "/",
      "body": {"action": "leaderboard", "rating_type": "online"},
      "expectedStatus": 200,
      "expectedBody": {"rating_type": "online"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get achievements without token",
      "method": "POST",
      "path": "/",
      "body": {"action": "get_achievements"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "List achievements public",
      "method": "POST",
      "path": "/",
      "body": {"action": "list_achievements"},
      "expectedStatus": 200
    },
    {
      "name": "Admin list without key",
      "method": "POST",
      "path": "/",
      "body": {"action": "admin_list_achievements"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin save without key",
      "method": "POST",
      "path": "/",
      "body": {"action": "admin_save_achievement", "achievement": {"id": "test", "title": "Test"}},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin delete without key",
      "method": "POST",
      "path": "/",
      "body": {"action": "admin_delete_achievement", "achievement_id": "test"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown_action"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
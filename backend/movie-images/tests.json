{
  "tests": [
    {
      "name": "Get all images",
      "method": "GET",
      "path": "/?all=1",
      "expectedStatus": 200,
      "expectedBody": {"images": {}},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get movie images",
      "method": "GET",
      "path": "/?movie_id=1",
      "expectedStatus": 200,
      "expectedBody": {"movie_id": 1},
      "bodyMatcher": "partial"
    },
    {
      "name": "Missing movie_id on GET",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {"error": "movie_id required"},
      "bodyMatcher": "partial"
    }
  ]
}
